{
  "id": "nb-normforms",
  "name": "Norsk normal transliterasjon",
  "description": "Norwegian input method with most common form transliterated",
  "date": "2012-12-04",
  "author": "John Erling Blad",
  "license": "GPLv3",
  "version": "1.0",
  "contextLength": 1,
  "maxKeyLength": 3,
  "dependencies": [],
  "rules": [
    {
      "pattern": "aa",
      "replacement": "å"
    },
    {
      "pattern": "AA",
      "replacement": "Å"
    },
    {
      "pattern": "Aa",
      "replacement": "Å"
    },
    {
      "pattern": "ae",
      "replacement": "æ"
    },
    {
      "pattern": "AE",
      "replacement": "Æ"
    },
    {
      "pattern": "Ae",
      "replacement": "Æ"
    },
    {
      "pattern": "oe",
      "replacement": "ø"
    },
    {
      "pattern": "OE",
      "replacement": "Ø"
    },
    {
      "pattern": "Oe",
      "replacement": "Ø"
    },
    {
      "pattern": "åa",
      "replacement": "aa",
      "contextRegex": "a",
      "context": "a"
    },
    {
      "pattern": "ÅA",
      "replacement": "AA",
      "contextRegex": "A",
      "context": "A"
    },
    {
      "pattern": "Åa",
      "replacement": "Aa",
      "contextRegex": "A",
      "context": "A"
    },
    {
      "pattern": "åA",
      "replacement": "aA",
      "contextRegex": "a",
      "context": "a"
    },
    {
      "pattern": "æe",
      "replacement": "ae",
      "contextRegex": "e",
      "context": "e"
    },
    {
      "pattern": "ÆE",
      "replacement": "AE",
      "contextRegex": "E",
      "context": "E"
    },
    {
      "pattern": "Æe",
      "replacement": "Ae",
      "contextRegex": "E",
      "context": "E"
    },
    {
      "pattern": "æE",
      "replacement": "aE",
      "contextRegex": "e",
      "context": "e"
    },
    {
      "pattern": "øe",
      "replacement": "oe",
      "contextRegex": "e",
      "context": "e"
    },
    {
      "pattern": "ØE",
      "replacement": "OE",
      "contextRegex": "E",
      "context": "E"
    },
    {
      "pattern": "Øe",
      "replacement": "Oe",
      "contextRegex": "E",
      "context": "E"
    },
    {
      "pattern": "øE",
      "replacement": "oE",
      "contextRegex": "e",
      "context": "e"
    }
  ]
}