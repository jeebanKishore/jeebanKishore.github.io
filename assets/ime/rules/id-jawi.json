{
  "id": "id-jawi",
  "name": "Jawi keyboard",
  "description": "Jawi keyboard for Indonesian Wikisource",
  "date": "2023-09-21",
  "author": "Benny Lin, Pungkas, Michael",
  "license": "GPLv3",
  "version": "1.0",
  "contextLength": 1,
  "maxKeyLength": 1,
  "dependencies": [],
  "rules": [
    {
      "pattern": "\\\\([A-Za-z\\>_~\\.0-9])",
      "replacement": "$1",
      "contextRegex": "",
      "context": ""
    },
    {
      "pattern": "(a|A)",
      "replacement": "ا",
      "contextRegex": "",
      "context": ""
