{
  "id": "eo-transliteration",
  "name": "Esperanto Transliteration",
  "description": "Esperanto x-code transliteration",
  "date": "2012-10-10",
  "author": "Brooke Vibber",
  "license": "GPLv3",
  "version": "1.0",
  "contextLength": 1,
  "maxKeyLength": 1,
  "dependencies": [],
  "rules": [
    {
      "pattern": "C[Xx]",
      "replacement": "Ĉ",
      "contextRegex": "C",
      "context": "C"
    },
    {
      "pattern": "Ĉ([Xx])",
      "replacement": "C$1",
      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "G[Xx]",
      "replacement": "Ĝ",
      "contextRegex": "G",
      "context": "G"
    },
    {
      "pattern": "Ĝ([Xx])",
      "replacement": "G$1",
      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "H[Xx]",
