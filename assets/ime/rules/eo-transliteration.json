      "contextRegex": "H",
      "context": "H"
    },
    {
      "pattern": "Ĥ([Xx])",
      "replacement": "H$1",
      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "J[Xx]",
