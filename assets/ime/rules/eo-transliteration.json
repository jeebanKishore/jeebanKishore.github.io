      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "j[Xx]",
      "replacement": "ĵ",
      "contextRegex": "j",
      "context": "j"
    },
    {
      "pattern": "ĵ([Xx])",
      "replacement": "j$1",
      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "s[Xx]",
      "replacement": "ŝ",
      "contextRegex": "s",
