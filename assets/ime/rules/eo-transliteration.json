      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "U[Xx]",
      "replacement": "Ŭ",
      "contextRegex": "U",
      "context": "U"
    },
    {
      "pattern": "Ŭ([Xx])",
      "replacement": "U$1",
      "contextRegex": "[Xx]",
      "context": "[Xx]"
    },
    {
      "pattern": "c[Xx]",
      "replacement": "ĉ",
      "contextRegex": "c",
      "context": "c"
    },
    {
      "pattern": "ĉ([Xx])",
